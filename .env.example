NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Runtime and cloud PAPER broker (Vercel/Railway).
TRADING_RUNTIME_MODE=LOCAL_DEVELOPMENT
BROKER_ADAPTER=ALPACA_PAPER
ALPACA_BROKER_ENVIRONMENT=PAPER
ALPACA_BROKER_API_KEY=
ALPACA_BROKER_API_SECRET=
ALPACA_BROKER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_BROKER_TIMEOUT_MS=10000

# IBKR Client Portal Gateway — PAPER account only.
IBKR_ENVIRONMENT=PAPER
IBKR_GATEWAY_URL=https://localhost:5000/v1/api
IBKR_REQUEST_TIMEOUT_MS=10000
IBKR_ALLOW_SELF_SIGNED_LOCAL_CERT=false
IBKR_ADAPTER=TWS
IBKR_TWS_BRIDGE_URL=http://127.0.0.1:8765
IBKR_TWS_HOST=127.0.0.1
IBKR_TWS_PORT=4002
IBKR_TWS_CLIENT_ID=41

# Alpaca Market Data only — never exposed to the browser or used for orders.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_FEED=iex
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_MARKET_DATA_CACHE_MS=5000
MARKET_DATA_MAX_AGE_MS=30000
BIG_MONEY_RECOMMENDATION_MAX_AGE_MS=1800000
BIG_MONEY_MAX_PRICE_CHANGE_PCT=1

# Railway hosted trading worker only. Never expose these with NEXT_PUBLIC_.
WORKER_ID=railway-trading-engine
WORKER_INTERVAL_MS=30000
WORKER_SCAN_SYMBOLS=AAPL,MSFT,NVDA,SPY
WORKER_VERSION=TRADE-010
AUTO_TRADER_INITIAL_STATE=PAUSED

AI_API_KEY=
RESEND_API_KEY=
