# Copy to .env.small-trading and fill in locally.
# Never commit the completed .env.small-trading file.

APCA_API_KEY_ID=replace-with-paper-account-key
APCA_API_SECRET_KEY=replace-with-paper-account-secret
APCA_DATA_FEED=iex

SMALL_TRADING_SYMBOLS=AAPL,MSFT,NVDA
SMALL_TRADING_SCAN_INTERVAL_SECONDS=60
SMALL_TRADING_DATABASE_PATH=/data/trading.db

# Generate a long random value locally; do not reuse a broker credential.
SMALL_TRADING_API_TOKEN=replace-with-a-long-random-token
